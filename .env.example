MODEL_ID=gemini-3.7-flash
BASE_URL=http://localhost:7860/v1
LOCAL_LLM_API_KEY=请填入本地端点密钥
ANDROID_DEVICE=auto
# 仅在 ANDROID_DEVICE=auto 时，任务成功后停止 Waydroid
STOP_WAYDROID_AFTER_RUN=true
DAILY_RUN_TIME=00:05
TIMEZONE=Asia/Shanghai
MAX_RETRIES=3
RETRY_COOLDOWN_SECONDS=10
MAX_STEPS=260
GENERATION_TIMEOUT_SECONDS=180
# 视觉网关无响应时的单次请求超时；超时会进入 MAX_RETRIES 重试
MODEL_REQUEST_TIMEOUT_SECONDS=90
TEST_PROMPT=healthy habits
TEST_IMAGE_PATH=测试题目.png
# 兑换目标固定为 QQ 超级会员 3 天卡；积分不足会安全跳过兑换
PROMPT_PATH=每日任务提示词.md
STATE_PATH=.yuanbao_daily_state.json
