MODEL_ID=gpt-6-luna
# 当前网络环境下通过本机 Clash 代理访问端点；若使用本地端点可改回 http://localhost:7860/v1
BASE_URL=https://cctq.ai/v1
HTTPS_PROXY=http://127.0.0.1:7897
LOCAL_LLM_API_KEY=请填入本地端点密钥
REASONING_EFFORT=max
ANDROID_DEVICE=auto
# 仅在 ANDROID_DEVICE=auto 时，任务成功后停止 Waydroid
STOP_WAYDROID_AFTER_RUN=true
# 自动处理已知系统兼容性提示；仅精确匹配元宝首次协议页并点击“同意并继续”，不会自动登录或处理验证码/扫码
AUTO_ACCEPT_PROTOCOL=true
DAILY_RUN_TIME=00:05
TIMEZONE=Asia/Shanghai
MAX_RETRIES=3
RETRY_COOLDOWN_SECONDS=10
MAX_STEPS=260
GENERATION_TIMEOUT_SECONDS=180
# 视觉网关无响应时的单次请求超时；超时会进入 MAX_RETRIES 重试
MODEL_REQUEST_TIMEOUT_SECONDS=180
TEST_PROMPT=What is 2 plus 2? Reply with just the number.
TEST_IMAGE_PATH=测试题目.png
TEST_AUDIO_PATH=语音测试.wav
# 兑换目标固定为 QQ 超级会员 3 天卡；积分不足会安全跳过兑换
PROMPT_PATH=每日任务提示词.md
STATE_PATH=.yuanbao_daily_state.json
# true：趣问元宝、写作、P图、拍题、做同款均不可因失败或暂时缺少文案而跳过
FORCE_ALL_DAILY_TASKS=true
# 固定任务完成后由视觉模型巡查新增任务；排除邀请好友、外部 App 和外部影响操作
SCAN_EXTRA_TASKS=true
